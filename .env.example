# ==========================================
# CVAT Configuration & Credentials Template
# Copy this file to .env and fill in your values
# ==========================================

CVAT_URL=https://your-cvat-instance.com
CVAT_USERNAME=your_username
CVAT_PASSWORD=your_secure_password

# Optional: Roboflow API key for dataset downloads
ROBOFLOW_API_KEY=your_roboflow_key_here
